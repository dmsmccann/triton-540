(text "LEVEL" (at 243.84 111.76 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a969cf63-85df-4541-90d7-87134b5c8cf1"))
(text "PITCH" (at 261.62 147.32 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "00e207fa-7a55-42c6-8dfc-74534ff5e9bc"))
(text "80274 AUDIO POWER AMPLIFIER" (at 210.82 20.32 0) (effects (font (size 2.0 2.0)) (justify left top)) (uuid "877f2829-69a8-44d1-9c20-3b8a0c5e7425"))
(text "Original arrangement: 540 manual, PDF page 35 / printed 3-19.\nService description and DC readings: PDF page 34 / printed 3-18.\nChassis wiring: PDF page 21 / printed 3-4." (at 312.42 35.56 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "36274f27-a17b-4139-b6dd-6e710a022ac8"))
(text "References preserve the original designators:\nC1 -> C74-1; IC-1 -> U74-1.\nThe manual has no R10; R74-14 is intentional." (at 312.42 73.66 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "780bed5d-8a3f-43d7-849a-422b1c793609"))
(text "U74-1: LM380N (manual alternative: ULN2280B).\nGround pins: 3, 4, 5, 7, 10, 11, 12.\nPins 9 and 13 are internally unconnected." (at 312.42 109.22 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "9a6545f8-7771-4202-8e7b-25ced4e8592d"))
(text "D74-2: 8.2 V Zener as documented.\nOriginal part number and package are unknown.\nNo substitute has been assigned." (at 312.42 144.78 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "4f22e922-72ff-4dc2-bfd7-eaa6451f221f"))
(text "Q74-2 is a unijunction transistor: B1, E, B2.\nQ74-3 switches the C74-5 timing return.\nQ74-2 B1 remains grounded." (at 312.42 180.34 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8c849936-f2d1-4e71-85d2-2d60b70bab87"))
