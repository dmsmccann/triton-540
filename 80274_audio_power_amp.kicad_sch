	(text "Original arrangement: 540 manual, PDF page 35 / printed 3-19.\nService description and DC readings: PDF page 34 / printed 3-18.\nChassis wiring: PDF page 21 / printed 3-4."
		(exclude_from_sim no)
		(at 300.99 35.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "36274f27-a17b-4139-b6dd-6e710a022ac8")
	)
	(text "D74-2: 8.2 V Zener as documented.\nOriginal part number and package are unknown.\nNo substitute has been assigned."
		(exclude_from_sim no)
		(at 300.99 144.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4f22e922-72ff-4dc2-bfd7-eaa6451f221f")
	)
	(text "References preserve the original designators:\nC1 -> C74-1; IC-1 -> U74-1.\nThe manual has no R10; R74-14 is intentional."
		(exclude_from_sim no)
		(at 300.99 73.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "780bed5d-8a3f-43d7-849a-422b1c793609")
	)
	(text "80274 AUDIO POWER AMPLIFIER"
		(exclude_from_sim no)
		(at 199.39 20.32 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "877f2829-69a8-44d1-9c20-3b8a0c5e7425")
	)
	(text "Q74-2 is a unijunction transistor: B1, E, B2.\nQ74-3 switches the C74-5 timing return.\nQ74-2 B1 remains grounded."
		(exclude_from_sim no)
		(at 300.99 180.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8c849936-f2d1-4e71-85d2-2d60b70bab87")
	)
	(text "U74-1: LM380N (manual alternative: ULN2280B).\nGround pins: 3, 4, 5, 7, 10, 11, 12.\nPins 9 and 13 are internally unconnected."
		(exclude_from_sim no)
		(at 300.99 109.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9a6545f8-7771-4202-8e7b-25ced4e8592d")
	)
