	(text "MODEL 245 CW FILTER  -  four-stage 750 Hz active audio bandpass\nSource: literature/Model 245.pdf, PDF p.3 / printed p.3-42 (schematic); PDF p.2 / printed p.3-41 (voltages)."
		(exclude_from_sim no)
		(at 20.32 22.86 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "0c33af4f-6169-4d08-8973-0eb580bfc317")
	)
	(text "Board pins (Model 245 name / 540 socket name; pin numbers inferred from the 540 socket\norder and the 1-4 jumper note; 540 manual PDF p.21 / printed p.3-4):\n1  INPUT / IN\n2  GND / GND\n3  +12V / +REG   - from 80280 +REG (about 8 V in the 540; the 245 sheet lists 13 V)\n4  OUT 1 / CW2   - stage 1 only, AC-coupled\n5  OUT 2 / (unnamed, no connection) - stage 2, DC at bias\n6  OUT 3 / (unnamed, no connection) - stage 3, DC at bias\n7  OUT 4 / CW1   - all four stages, AC-coupled\nWithout the filter a blue jumper on the 540 socket joins pins 1 and 4."
		(exclude_from_sim no)
		(at 152.4 17.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3cdbd818-248b-4ecf-99eb-d4f847e5096c")
	)
	(text "NOTE: No connections to pins 3, 5, 14, 11, 8 - IC45-1 & IC45-2.\nIC45-1, IC45-2  uA747/C.   All R & C +/-5% except * (C45-1, C45-4, C45-7, C45-12, R45-4, R45-6).\n\n"
		(exclude_from_sim no)
		(at 139.7 142.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d159fe54-a5dd-460c-88c9-f0e3c5adbe66")
	)
